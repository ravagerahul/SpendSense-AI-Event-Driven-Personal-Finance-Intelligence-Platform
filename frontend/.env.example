# Copy to .env.local and adjust. Vite reads VITE_* at BUILD time, so changing this needs a
# rebuild, not a restart.
#
# The base URL of whatever fronts the API. The frontend talks to exactly one origin - that is
# the point of the BFF - so this is the only backend setting there is.
#
#   http://localhost:8087   dashboard-service directly: services started from an IDE against
#                           docker-compose.yml, with no proxy in front.
#   http://localhost        the containerized stack: Caddy on port 80 routes everything that
#                           is not /api/sms-ingest to the BFF. dashboard-service no longer
#                           publishes a port, so 8087 is not reachable from the host.
#   https://your.domain     deployed, once CADDY_DOMAIN is a real hostname.
#
# Left unset, the client defaults to http://localhost:8087.
VITE_API_BASE_URL=http://localhost
