{
  "set": "test",
  "description": "HELD-OUT categorization cases. Thirty-two merchant/amount/type triples, none of which appears in the dev set, written after the categorization prompt was frozen. No failure here has ever been used to change a prompt.",
  "ambiguityNote": "Each case may declare acceptableAlternatives: categories a careful human could also defend. The scored accuracy is strict - only 'expected' counts as correct - but a miss that lands in acceptableAlternatives is classified as 'ambiguous' in the error taxonomy rather than 'clearly wrong'. The alternatives are declared here, before any run, so the classification cannot be fitted to the results afterwards.",
  "labellingNote": "Same two product rules as the dev set: a CREDIT from an individual is Transfers, and a DEBIT to a bare personal name with no context is Needs Manual Categorization.",
  "cases": [
    { "id": "t-zepto",        "merchant": "Zepto",                     "amount": 150.00,    "transactionType": "DEBIT",  "expected": "Groceries",         "acceptableAlternatives": ["Food & Dining"], "source": "Quick-commerce grocery app; sells groceries but is often read as food delivery." },
    { "id": "t-dominos",      "merchant": "Dominos Pizza",             "amount": 240.00,    "transactionType": "DEBIT",  "expected": "Food & Dining" },
    { "id": "t-nykaa",        "merchant": "Nykaa",                     "amount": 3499.00,   "transactionType": "DEBIT",  "expected": "Shopping",          "acceptableAlternatives": ["Health"], "source": "Beauty and cosmetics retailer; stocks some pharmacy lines." },
    { "id": "t-decathlon",    "merchant": "Decathlon",                 "amount": 4999.00,   "transactionType": "DEBIT",  "expected": "Shopping",          "acceptableAlternatives": ["Health"] },
    { "id": "t-rapido",       "merchant": "Rapido",                    "amount": 325.00,    "transactionType": "DEBIT",  "expected": "Transport",         "acceptableAlternatives": ["Travel"] },
    { "id": "t-lenskart",     "merchant": "Lenskart",                  "amount": 1799.00,   "transactionType": "DEBIT",  "expected": "Shopping",          "acceptableAlternatives": ["Health"], "source": "Eyewear. Prescription glasses are arguably Health, frames arguably Shopping." },
    { "id": "t-licious",      "merchant": "Licious",                   "amount": 670.00,    "transactionType": "DEBIT",  "expected": "Groceries",         "acceptableAlternatives": ["Food & Dining"] },
    { "id": "t-urbancompany", "merchant": "Urban Company",             "amount": 1100.00,   "transactionType": "DEBIT",  "expected": "Other",             "acceptableAlternatives": ["Bills & Utilities", "Shopping", "Health"], "source": "At-home services marketplace - cleaning, repairs, salon. No category in the closed list fits, which is what Other is for." },
    { "id": "t-ccd",          "merchant": "Cafe Coffee Day",           "amount": 560.00,    "transactionType": "DEBIT",  "expected": "Food & Dining" },
    { "id": "t-reliancesmart","merchant": "Reliance Smart",            "amount": 2875.50,   "transactionType": "DEBIT",  "expected": "Groceries",         "acceptableAlternatives": ["Shopping"], "source": "Supermarket chain selling groceries and general merchandise." },
    { "id": "t-igl",          "merchant": "Indraprastha Gas",          "amount": 1042.00,   "transactionType": "DEBIT",  "expected": "Bills & Utilities" },
    { "id": "t-pvr",          "merchant": "PVR Cinemas",               "amount": 1180.00,   "transactionType": "DEBIT",  "expected": "Entertainment" },
    { "id": "t-ajio",         "merchant": "Ajio",                      "amount": 2199.00,   "transactionType": "CREDIT", "expected": "Shopping",          "source": "A refund from a clothing retailer. The direction is CREDIT but the category is still what the money was spent on." },
    { "id": "t-hdfclife",     "merchant": "HDFC Life",                 "amount": 18420.00,  "transactionType": "DEBIT",  "expected": "Bills & Utilities", "acceptableAlternatives": ["Other", "Health"], "source": "Life insurance premium. The closed list has no Insurance category, so this is a genuine forced choice." },
    { "id": "t-hppetrol",     "merchant": "HP Petrol Pump",            "amount": 3000.00,   "transactionType": "DEBIT",  "expected": "Transport" },
    { "id": "t-infosys-div",  "merchant": "Infosys Ltd",               "amount": 1840.00,   "transactionType": "CREDIT", "expected": "Income",            "source": "A share dividend. Earned money arriving, so Income rather than Transfers." },
    { "id": "t-instamart",    "merchant": "Swiggy Instamart",          "amount": 2340.00,   "transactionType": "DEBIT",  "expected": "Groceries",         "acceptableAlternatives": ["Food & Dining"], "source": "Deliberately adversarial: the name begins with a merchant the dev set labels Food & Dining, but Instamart sells groceries." },
    { "id": "t-amazonpay",    "merchant": "Amazon Pay",                "amount": 899.00,    "transactionType": "DEBIT",  "expected": "Shopping",          "acceptableAlternatives": ["Transfers", "Bills & Utilities", "Other"], "source": "A wallet, not a shop. Could be any of several things; the name only says who processed it." },
    { "id": "t-nova-salary",  "merchant": "Nova Software Pvt Ltd",     "amount": 12500.00,  "transactionType": "CREDIT", "expected": "Income" },
    { "id": "t-meera",        "merchant": "Meera Iyer",                "amount": 3000.00,   "transactionType": "CREDIT", "expected": "Transfers",         "source": "Held-out instance of the Priya Sharma case: a credit from an individual." },
    { "id": "t-arjun",        "merchant": "Arjun Menon",               "amount": 4500.00,   "transactionType": "DEBIT",  "expected": "Needs Manual Categorization", "acceptableAlternatives": ["Transfers"] },
    { "id": "t-kavya",        "merchant": "Kavya",                     "amount": 800.00,    "transactionType": "DEBIT",  "expected": "Needs Manual Categorization", "acceptableAlternatives": ["Transfers"] },
    { "id": "t-sunrise",      "merchant": "Sunrise Builders Pvt Ltd",  "amount": 125000.00, "transactionType": "DEBIT",  "expected": "Other",             "acceptableAlternatives": ["Bills & Utilities", "Transfers", "Shopping"], "source": "A large payment to a construction company. A business, so not Needs Manual Categorization, but nothing in the list describes it." },
    { "id": "t-cultfit",      "merchant": "Cult.fit",                  "amount": 2400.00,   "transactionType": "DEBIT",  "expected": "Health",            "acceptableAlternatives": ["Subscriptions", "Entertainment"], "source": "A gym membership: recurring, so arguably Subscriptions, but what it buys is fitness." },
    { "id": "t-tata1mg",      "merchant": "Tata 1mg",                  "amount": 890.00,    "transactionType": "DEBIT",  "expected": "Health" },
    { "id": "t-practo",       "merchant": "Practo",                    "amount": 500.00,    "transactionType": "DEBIT",  "expected": "Health" },
    { "id": "t-jio",          "merchant": "Jio",                       "amount": 299.00,    "transactionType": "DEBIT",  "expected": "Bills & Utilities", "acceptableAlternatives": ["Subscriptions"] },
    { "id": "t-tatapower",    "merchant": "Tata Power",                "amount": 3240.00,   "transactionType": "DEBIT",  "expected": "Bills & Utilities" },
    { "id": "t-oyo",          "merchant": "OYO Rooms",                 "amount": 2800.00,   "transactionType": "DEBIT",  "expected": "Travel" },
    { "id": "t-redbus",       "merchant": "RedBus",                    "amount": 760.00,    "transactionType": "DEBIT",  "expected": "Travel",            "acceptableAlternatives": ["Transport"], "source": "Intercity bus booking. Travel and Transport genuinely overlap here, which is the same fault line as Uber in the dev set." },
    { "id": "t-cleartrip",    "merchant": "Cleartrip",                 "amount": 11200.00,  "transactionType": "DEBIT",  "expected": "Travel" },
    { "id": "t-atm",          "merchant": "ATM Withdrawal",            "amount": 5000.00,   "transactionType": "DEBIT",  "expected": "Other",             "acceptableAlternatives": ["Transfers"], "source": "Cash leaving the account. What it was later spent on is unknowable from the SMS." }
  ]
}
