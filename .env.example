# Copy to .env and fill in. .env is gitignored and must stay that way: it holds the Gemini key
# and the database password.
#
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build
#
# Every variable here also has a sensible local-development default baked into each service's
# application.properties, so running from an IDE against docker-compose.yml needs none of this.

# --- secrets ---------------------------------------------------------------
# From Google AI Studio. Never commit a real value; never put it in a Dockerfile, where it
# would survive in the image layer even if a later line deleted it.
GEMINI_API_KEY=

# The key callers must present as X-API-Key on POST /api/sms-ingest. Change it from the
# development default before anything is reachable from outside the host.
INGESTION_API_KEY=

# --- database --------------------------------------------------------------
POSTGRES_DB=spendsense
POSTGRES_USER=spendsense
POSTGRES_PASSWORD=

# --- exposure --------------------------------------------------------------
# The hostname Caddy serves. Caddy is the only container with a published port (80 and 443);
# every service behind it is reachable by service name on the compose network and nowhere else.
#
#   :80                     plain HTTP, no certificate. Local verification, or a bare IP -
#                           Let's Encrypt does not issue certificates for IP addresses.
#   spendsense.example.com  a real hostname. Caddy then obtains and renews a Let's Encrypt
#                           certificate by itself, and redirects HTTP to HTTPS.
CADDY_DOMAIN=:80

# Origins the browser is allowed to call the BFF from. Comma-separated, no trailing slash.
# This is the CADDY origin now, not the BFF's own port - the browser never sees 8087.
# Include http://localhost:3000 while the frontend runs on the Vite dev server.
DASHBOARD_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# --- logging ---------------------------------------------------------------
# Where the JSON log files are written. Only used OUTSIDE the prod profile: containers run
# with SPRING_PROFILES_ACTIVE=prod, where the file appender is switched off entirely and
# everything goes to stdout for the platform to collect. Set it when running on a host where
# the absolute default path in logback-spring.xml does not exist.
SPENDSENSE_LOG_DIR=

# --- tuning ----------------------------------------------------------------
# The BFF pings seven services in parallel on /api/health. Containers start cold, so this is
# higher under the prod profile than the 5s used locally.
DASHBOARD_HEALTH_TIMEOUT_MS=15000

GEMINI_MODEL=gemini-3.5-flash-lite
# Below this categorization confidence a transaction goes to the review queue.
REVIEW_THRESHOLD=0.7
# Prior transactions required before the unusual-amount rule may fire.
ANOMALY_MIN_HISTORY=3
# Rows retrieved by the semantic path. Not a cap on anything the aggregation path sums.
RAG_TOP_K=5
# Candidate merchant names offered to the SQL prompt.
MERCHANT_TOP_K=10
INSIGHTS_CRON=0 0 0 * * SUN
INSIGHTS_PERIOD_DAYS=7
INSIGHTS_MIN_OCCURRENCES=3
